# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: if all three are set, docker-entrypoint.sh creates this superuser
# automatically on first boot (skipped silently if unset, or if it already exists).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# MySQL
MYSQL_DATABASE=bankstatements
MYSQL_USER=bankstatements
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_HOST=db
MYSQL_PORT=3306

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Gunicorn (web service only — celery-worker/celery-beat ignore these)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# Field-level encryption key for stored Plaid access tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# Plaid (https://dashboard.plaid.com) — start in sandbox, no cost
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://your-domain.example/api/webhooks/plaid/

# S3-compatible storage for statements/check images (optional in dev; falls back to local media/)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
