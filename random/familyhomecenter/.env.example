# Copy this file to .env in the project root and fill in real values.
# See docs/ for step-by-step setup guides for each integration.

# ---- Server ----
PORT=3000
HOST=0.0.0.0
TZ=America/Los_Angeles

# ---- Google Calendar (optional) ----
# See docs/GOOGLE_CALENDAR_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client, e.g. http://familyhub.local:3000/api/calendar/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# ---- Apple/iCloud Calendar (optional) ----
# See docs/APPLE_CALENDAR_SETUP.md
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# ---- Weather (Open-Meteo, no key needed) ----
WEATHER_LAT=37.4419
WEATHER_LON=-122.1430
WEATHER_LOCATION_NAME="Palo Alto, CA"

# ---- Photos / Slideshow ----
# Local directory (or SMB mount point, see docs/PHOTOS_SETUP.md) to scan for photos.
PHOTOS_DIR=/home/pi/family-photos

# ---- Movies (photo slideshow + music, rendered with ffmpeg) ----
# Requires ffmpeg installed as a system package (`sudo apt install ffmpeg`) — see docs/MOVIES_SETUP.md.
# Leave blank to use ffmpeg from PATH (the normal case); only set this if it's installed somewhere unusual.
FFMPEG_PATH=

# ---- Music (local library + multi-zone) ----
# See docs/MUSIC_SETUP.md for the DAC8x/ALSA/MPD/librespot setup this all assumes.
MUSIC_LIBRARY_DIR=/home/pi/music
MUSIC_ZONE_COUNT=4
MPD_HOST=127.0.0.1
MPD_BASE_PORT=6600
# Shared secret the librespot --onevent hook script sends so nothing else on the LAN can spoof "now playing".
# Generate one with: openssl rand -hex 24
INTERNAL_API_TOKEN=

# ---- Spotify (optional, adds in-dashboard playback control; Spotify Connect casting from
# family members' own phones works with zero setup — see docs/SPOTIFY_SETUP.md) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/music/spotify/callback

# ---- Intercom ----
# ALSA device name prefix for each zone (zone1, zone2, ... — see docs/MUSIC_SETUP.md).
INTERCOM_ALSA_PREFIX=zone
# Volume (%) a zone's music ducks to while a page is playing into it.
INTERCOM_DUCK_VOLUME=20

# ---- Grocery list email (optional) ----
# Emails the current grocery list to every parent with an email set (Settings > family member,
# or their own profile) every night at midnight. Any SMTP account works, e.g. a Gmail account
# with an App Password. Leave SMTP_HOST blank to disable. See docs/GROCERY_EMAIL_SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Family Home Center <noreply@example.com>"

# ---- Browser calling (optional, paid) ----
# Real click-to-call from Contacts on any browser (not just phones), via Twilio Voice. Needs a
# paid Twilio account and a public HTTPS URL Twilio can reach — see docs/TWILIO_CALLING_SETUP.md.
# Leave TWILIO_ACCOUNT_SID blank to disable; tel:/sms: links and email-to-SMS texting work either way.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_NUMBER=

# ---- Photo documents: PDF download (optional) ----
# PDF downloads of photo documents use LibreOffice (sudo apt install libreoffice-writer-nogui).
# Word (.docx) downloads work without it. Only set this if soffice isn't on PATH.
SOFFICE_PATH=

# ---- Internet controls via Pi-hole (optional) ----
# Pause the internet per family member, bedtime schedules, and kid-safe web filtering, all through
# a Pi-hole v6 on your network (usually this same Pi). Leave PIHOLE_URL blank to disable. See
# docs/PIHOLE_SETUP.md.
PIHOLE_URL=
PIHOLE_PASSWORD=

# ---- Settings login (optional) ----
# Gates the Settings page + configuration changes (family roster, calendar/Spotify connect, timing).
# Everything else (chores, calendar, music, photos, intercom) stays open either way. Leave blank to
# leave Settings open too. See docs/SETTINGS_LOGIN.md.
ADMIN_PASSWORD=
