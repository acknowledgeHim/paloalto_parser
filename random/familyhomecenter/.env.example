# Copy this file to .env in the project root and fill in real values.
# See docs/ for step-by-step setup guides for each integration.

# ---- Server ----
PORT=3000
HOST=0.0.0.0
TZ=America/Los_Angeles

# ---- Google Calendar (optional) ----
# See docs/GOOGLE_CALENDAR_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client, e.g. http://familyhub.local:3000/api/calendar/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# ---- Apple/iCloud Calendar (optional) ----
# See docs/APPLE_CALENDAR_SETUP.md
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# ---- Weather (Open-Meteo, no key needed) ----
WEATHER_LAT=37.4419
WEATHER_LON=-122.1430
WEATHER_LOCATION_NAME="Palo Alto, CA"

# ---- Photos / Slideshow ----
# Local directory (or SMB mount point, see docs/PHOTOS_SETUP.md) to scan for photos.
PHOTOS_DIR=/home/pi/family-photos
