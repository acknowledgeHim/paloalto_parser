# Template for one zone's MPD instance. generate-mpd-configs.sh fills in {{ZONE}} and writes
# /etc/mpd-zone{{ZONE}}.conf for zones 1..N. All zones share the same music_directory (one copy
# of your files) but keep separate databases/state, since each is logically an independent player.

# MPD refuses to start as root unless told which unprivileged user to drop to (a safety check baked
# into mpd itself, not something this config can skip) — the systemd unit has no User=, so it starts
# as root and needs this. Must be a user with read access to music_directory and a member of the
# `audio` group (the default `pi` user already is, on Raspberry Pi OS).
user               "{{RUN_USER}}"

music_directory    "{{MUSIC_DIR}}"
db_file            "{{DATA_DIR}}/mpd-zone{{ZONE}}/db"
log_file           "{{DATA_DIR}}/mpd-zone{{ZONE}}/log"
pid_file           "{{DATA_DIR}}/mpd-zone{{ZONE}}/pid"
state_file         "{{DATA_DIR}}/mpd-zone{{ZONE}}/state"
sticker_file       "{{DATA_DIR}}/mpd-zone{{ZONE}}/sticker.sql"

bind_to_address    "127.0.0.1"
port               "660{{ZONE}}"

audio_output {
  type        "alsa"
  name        "Zone {{ZONE}}"
  device      "zone{{ZONE}}"   # matches asound.conf.dac8x
  mixer_type  "software"       # gives this zone independent volume even though the ALSA device is shared
}

restore_paused "yes"
